#!/usr/bin/env bash
set -uo pipefail

APP="pve-ip-mount-retry"

log() {
    printf '%s [%s] %s\n' "$(date '+%F %T')" "$APP" "$*"
    logger -t "$APP" -- "$*" 2>/dev/null || true
}

die() {
    log "ERROR: $*" >&2
    exit 1
}

require_root() {
    [[ ${EUID:-$(id -u)} -eq 0 ]] || die "must run as root"
}

require_commands() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "missing required command: $cmd"
    done
}

# Match either an IPv4 address or a bracketed IPv6 address and print the
# matched text (nothing, if neither is present).
#
# This is used ONLY to decide whether an /etc/fstab entry is IP-backed at
# all (the entry point into everything else this script does). It is
# deliberately NOT used to decide whether an already-mounted target is the
# expected one - see the full-source comparison in handle_entry(). Two
# shares on the same server, e.g. //203.0.113.10/media and
# //203.0.113.10/backups, share an endpoint but are different remote
# resources, and matching on the endpoint alone would treat them as
# interchangeable.
IPV4_RE='([0-9]{1,3}\.){3}[0-9]{1,3}'
IPV6_RE='\[[0-9A-Fa-f:]+\]'

extract_endpoint() {
    local s="$1"
    if [[ "$s" =~ $IPV4_RE ]]; then
        printf '%s' "${BASH_REMATCH[0]}"
    elif [[ "$s" =~ $IPV6_RE ]]; then
        printf '%s' "${BASH_REMATCH[0]}"
    fi
}

found=0
requested=0
waited=0
blocked=0

# Evaluate one /etc/fstab entry (already filtered to cifs/nfs/nfs4 by the
# caller) and, if it's IP-backed, bring it in line with the state machine
# described in the README:
#
#   target already mounted (exact mountpoint)
#       -> full source matches configured source: OK, leave alone
#       -> full source differs (same server, different share/export;
#          different server; or an unrelated filesystem entirely):
#                                        BLOCKED, leave alone, report it
#   target missing
#       -> no generated .mount unit:    WARN, skip
#       -> unit already activating:     WAIT, skip this cycle
#       -> otherwise:                   reset-failed, then start --no-block
handle_entry() {
    local source="$1" target="$2" fstype="$3"
    local endpoint actual unit state

    # Endpoint extraction only decides whether this fstab entry is
    # IP-backed at all; it plays no part in the already-mounted check
    # below, which compares full source strings instead.
    endpoint="$(extract_endpoint "$source")"
    [[ -n "$endpoint" ]] || return 0
    found=$((found + 1))

    # Exact mountpoint check (findmnt -M), never a path-resolving lookup:
    # an absent remote mount must never be mistaken for the underlying
    # local directory, and a mountpoint that's already occupied must never
    # be mounted over, unmounted, or otherwise modified.
    #
    # The live source is compared to the configured source as a complete
    # string (--raw plus the same \xNN decode used for the fstab side
    # below), not just by server endpoint: same-server-different-share
    # (//203.0.113.10/media vs //203.0.113.10/backups), a different
    # server, or an unrelated local filesystem occupying the target must
    # all be reported as BLOCKED rather than accepted as OK. This is
    # intentionally an exact match with no further normalization - if a
    # real deployment turns out to need one (e.g. a formatting difference
    # between what's written in /etc/fstab and what the kernel reports
    # back), that should be added deliberately once observed, not guessed
    # at here; until then, an unverifiable mismatch fails safe as BLOCKED.
    actual="$(findmnt -rn -M "$target" -o SOURCE --raw 2>/dev/null || true)"
    actual="$(printf '%b' "$actual")"
    if [[ -n "$actual" ]]; then
        if [[ "$actual" == "$source" ]]; then
            log "OK: already mounted: $target <- $actual ($fstype)"
        else
            blocked=$((blocked + 1))
            log "BLOCKED: $target is mounted from an unexpected source ($actual); expected $source. Leaving it alone."
        fi
        return 0
    fi

    # /mnt/data -> mnt-data.mount
    unit="$(systemd-escape --path --suffix=mount "$target")"

    # The mount unit should have been generated from /etc/fstab.
    if ! systemctl cat "$unit" >/dev/null 2>&1; then
        log "WARN: no systemd mount unit for $target ($unit); skipping"
        return 0
    fi

    # A unit that's already activating (our previous cycle's request, or
    # systemd's own retry) should be left to finish. Resetting/restarting
    # it here would just interrupt an attempt already in flight.
    state="$(systemctl is-active "$unit" 2>/dev/null || true)"
    if [[ "$state" == "activating" ]]; then
        waited=$((waited + 1))
        log "WAIT: $unit is already activating; skipping this cycle"
        return 0
    fi

    # Clear previous failed state. Safe if it isn't failed.
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true

    # Non-blocking is deliberate:
    # if a NAS is still offline we don't want this retry service hanging.
    if systemctl start --no-block "$unit"; then
        requested=$((requested + 1))
        log "RETRY: requested start of $unit for $target <- $source ($fstype)"
    else
        log "WARN: could not request start of $unit for $target"
    fi
}

main() {
    require_root
    require_commands findmnt systemctl systemd-escape

    while read -r source target fstype; do
        [[ -n "${source:-}" && -n "${target:-}" && -n "${fstype:-}" ]] || continue

        # findmnt escapes spaces etc. as \xNN; decode them.
        source="$(printf '%b' "$source")"
        target="$(printf '%b' "$target")"

        handle_entry "$source" "$target" "$fstype"
    done < <(
        findmnt \
            --fstab \
            --noheadings \
            --raw \
            --types cifs,nfs,nfs4 \
            --output SOURCE,TARGET,FSTYPE \
            2>/dev/null
    )

    if (( found == 0 )); then
        log "No IP-backed CIFS/NFS mounts found in /etc/fstab"
    else
        log "checked $found IP-backed mount(s): $requested retried, $waited already activating, $blocked blocked on an unexpected source"
    fi

    # An unavailable NAS is an expected condition, not a service failure.
    exit 0
}

# Allow this file to be sourced (by the test suite) without running main.
if [[ "${BASH_SOURCE[0]:-$0}" == "${0}" ]]; then
    main "$@"
fi
