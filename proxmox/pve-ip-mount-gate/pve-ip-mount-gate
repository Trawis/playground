#!/usr/bin/env bash
set -uo pipefail

APP="pve-ip-mount-gate"
STATE_DIR="/etc/${APP}"
RUNTIME_DIR="/run/${APP}"
MOUNT_DB="${STATE_DIR}/mounts.db"
PENDING_FILE="${RUNTIME_DIR}/pending"
LOCK_FILE="${RUNTIME_DIR}/lock"
CONFIG_FILE="/etc/default/${APP}"

GATE_TAG="ipmount-gated"
IO_TIMEOUT="8"
IP_RE='([0-9]{1,3}\.){3}[0-9]{1,3}'

[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

log() {
    echo "$(date '+%F %T') [${APP}] $*"
}

die() {
    log "ERROR: $*" >&2
    exit 1
}

require_root() {
    [[ ${EUID:-$(id -u)} -eq 0 ]] || die "must run as root"
}

ensure_runtime() {
    mkdir -p "$STATE_DIR" "$RUNTIME_DIR"
    touch "$MOUNT_DB"
}

acquire_lock() {
    ensure_runtime
    exec 9>"$LOCK_FILE"
    flock -w 30 9 || die "could not acquire lock: $LOCK_FILE"
}

extract_ip() {
    grep -Eo "$IP_RE" <<<"$1" | head -n1
}

# findmnt --raw escapes whitespace and other separator-sensitive bytes as
# \xNN; decode that consistently everywhere a raw findmnt field is read; so
# that exact-string source comparisons downstream (see mount_ready_map)
# aren't defeated by escaping differences.
decode_findmnt_field() {
    printf '%b' "$1"
}

# Mount database record format (pipe-separated, 4 fields):
#
#   target | source | kind | origin
#
# target  - the local mountpoint.
# source  - the expected remote resource identity. Its meaning depends on
#           kind (below).
# kind    - "full": source is the complete remote resource (as it would
#             appear as SOURCE in /proc/mounts, e.g. //203.0.113.10/media
#             or 203.0.113.20:/exports/media). An already-mounted target
#             is only accepted if its live source matches this exactly.
#           "endpoint": source is just the server address. This is a
#             deliberately weaker identity, used only when the complete
#             remote resource genuinely couldn't be determined (a
#             storage.cfg entry missing the field it needs - see README)
#             or when carrying forward a record from the previous
#             (pre-4-field) schema during upgrade. An already-mounted
#             target is accepted if its live source's server address
#             matches - same as this project's original behavior, but as
#             an exact match on the extracted address rather than a
#             substring check.
# origin  - free-text provenance for diagnostics/status (e.g.
#           "fstab:nfs4", "pve:cifs:mystorage", "mounted:cifs").
#
# fstab and live/custom discovery always know the complete source, so they
# always emit kind=full. Proxmox storage.cfg entries emit kind=full only
# when the config gives enough to reconstruct the exact remote resource
# (see the storage.cfg parser below); otherwise kind=endpoint.
emit_remote_mount() {
    local target="$1"
    local source="$2"
    local kind="$3"
    local origin="$4"
    local ip

    [[ -n "$target" && -n "$source" && -n "$kind" ]] || return 0

    ip="$(extract_ip "$source" || true)"
    [[ -n "$ip" ]] || return 0

    # A plain absolute local path is not remote. CIFS //IP/share is remote.
    if [[ "$source" == /* && "$source" != //* ]]; then
        return 0
    fi

    target="${target%/}"
    [[ -n "$target" ]] || target="/"

    printf '%s|%s|%s|%s\n' "$target" "$source" "$kind" "$origin"
}

# Parse a Proxmox storage.cfg file and print one target|source|kind|origin
# line per nfs:/cifs: storage definition - the same record shape
# emit_remote_mount() produces elsewhere. This is a standalone function
# (rather than inlined into discover_current_mounts) specifically so the
# test suite can run this exact parser against a fixture file instead of
# a duplicated copy that could silently drift from production behavior.
# Prints nothing if the file doesn't exist or isn't readable.
#
# nfs: the documented `export` field is the exact path exported by the
# server, so `server:export` reconstructs the full source (kind=full) -
# the same identity a matching fstab entry would have.
#
# cifs: the documented `share` field gives the exact share name, and
# Proxmox's own CIFS mount source construction appends an optional
# `subdir` directly after it, so `//server/share<subdir>` (subdir already
# carries its own leading slash, e.g. "/movies") reconstructs the full
# source (kind=full) whenever `share` is set, subdir or not.
#
# Anything without enough to reconstruct the exact remote resource (an
# nfs: entry with no `export`, or a cifs: entry with no `share`) still
# gets a record, just at endpoint (server-only) identity, rather than
# being dropped and silently stopping the gate from tracking it at all.
parse_storage_cfg() {
    local file="$1"
    [[ -r "$file" ]] || return 0
    awk '
        function flush() {
            if ((type == "nfs" || type == "cifs") && server != "") {
                p = path
                if (p == "") p = "/mnt/pve/" id
                if (type == "nfs" && xport != "") {
                    src = server ":" xport
                    kind = "full"
                } else if (type == "cifs" && share != "") {
                    src = "//" server "/" share subdir
                    kind = "full"
                } else {
                    src = server
                    kind = "endpoint"
                }
                print p "|" src "|" kind "|pve:" type ":" id
            }
        }
        /^[^[:space:]][^:]*:[[:space:]]+/ {
            flush()
            line=$0
            type=line; sub(/:.*/, "", type)
            id=line; sub(/^[^:]+:[[:space:]]*/, "", id)
            server=""; path=""; xport=""; share=""; subdir=""
            next
        }
        /^[[:space:]]+server[[:space:]]+/ {
            server=$0; sub(/^[[:space:]]+server[[:space:]]+/, "", server); next
        }
        /^[[:space:]]+path[[:space:]]+/ {
            path=$0; sub(/^[[:space:]]+path[[:space:]]+/, "", path); next
        }
        /^[[:space:]]+export[[:space:]]+/ {
            xport=$0; sub(/^[[:space:]]+export[[:space:]]+/, "", xport); next
        }
        /^[[:space:]]+share[[:space:]]+/ {
            share=$0; sub(/^[[:space:]]+share[[:space:]]+/, "", share); next
        }
        /^[[:space:]]+subdir[[:space:]]+/ {
            subdir=$0; sub(/^[[:space:]]+subdir[[:space:]]+/, "", subdir); next
        }
        END { flush() }
    ' "$file"
}

discover_current_mounts() {
    {
        # /etc/fstab: discover even when currently unmounted. The fstab
        # SOURCE is itself the complete remote resource, so this is
        # always a full-identity record.
        while read -r target source fstype; do
            [[ -n "${target:-}" ]] || continue
            target="$(decode_findmnt_field "$target")"
            source="$(decode_findmnt_field "$source")"
            emit_remote_mount "$target" "$source" "full" "fstab:${fstype:-unknown}"
        done < <(findmnt --fstab -rn -o TARGET,SOURCE,FSTYPE 2>/dev/null || true)

        # Proxmox NFS/CIFS storage definitions: discover even when unavailable.
        parse_storage_cfg /etc/pve/storage.cfg |
        while IFS='|' read -r target src kind origin; do
            emit_remote_mount "$target" "$src" "$kind" "$origin"
        done

        # Custom mounts not represented above: remember them while mounted.
        # The live SOURCE is the complete remote resource (kind=full).
        while read -r target source fstype; do
            [[ -n "${target:-}" ]] || continue
            target="$(decode_findmnt_field "$target")"
            source="$(decode_findmnt_field "$source")"
            emit_remote_mount "$target" "$source" "full" "mounted:${fstype:-unknown}"
        done < <(findmnt -rn -o TARGET,SOURCE,FSTYPE 2>/dev/null || true)
    } | awk -F'|' 'NF >= 4 && !seen[$1]++'
}

# Re-emit a previously-persisted "mounted:"-origin (custom) record for the
# next MOUNT_DB, translating it forward if it's in the legacy 3-field
# schema (target|ip|origin) used before this version. A legacy record is
# migrated to kind=endpoint using its remembered IP: that keeps a
# currently-unavailable custom mount from being silently forgotten across
# the upgrade, without pretending the old schema ever recorded a complete
# share/export identity it didn't. Once that mount is next seen live,
# discover_current_mounts() replaces it with a full-identity record.
#
# Configured (fstab:/pve:) origin records are intentionally NOT carried
# forward here, in either schema - discover_current_mounts() regenerates
# them fresh on every refresh, so nothing is lost by dropping stale copies.
#
# This function's stdout is consumed as MOUNT_DB records by its caller
# (refresh_mount_db, inside the pipeline that rebuilds MOUNT_DB), so its
# own diagnostics go to stderr instead - otherwise they'd be piped into
# the database as if they were data, and never reach the journal/log.
carry_forward_custom_record() {
    local rec="$1"
    local f1 f2 f3 f4

    IFS='|' read -r f1 f2 f3 f4 <<<"$rec"
    [[ -n "$f1" ]] || return 0

    if [[ "$f3" == "full" || "$f3" == "endpoint" ]]; then
        # Current schema already.
        [[ "$f4" == mounted:* ]] && printf '%s\n' "$rec"
        return 0
    fi

    if [[ -n "$f2" && "$f3" == mounted:* && -z "$f4" ]]; then
        # Legacy schema: target|ip|origin.
        log "migrating legacy mount record for $f1 (origin $f3) to endpoint-only identity; the previous schema did not record an exact share/export" >&2
        printf '%s|%s|endpoint|%s\n' "$f1" "$f2" "$f3"
        return 0
    fi

    if [[ "$rec" == *"mounted:"* ]]; then
        log "WARN: could not parse remembered custom mount record for $f1, discarding: $rec" >&2
    fi
}

refresh_mount_db() {
    local tmp rec
    ensure_runtime
    tmp="$(mktemp)"

    # Keep previously seen custom mounts so a currently-unavailable custom
    # mount remains a dependency. Configured fstab/PVE mounts are refreshed.
    {
        # Current configuration/live state wins if a custom mount changes source.
        discover_current_mounts
        while IFS= read -r rec; do
            [[ -n "$rec" ]] || continue
            carry_forward_custom_record "$rec"
        done < "$MOUNT_DB"
    } | awk -F'|' 'NF >= 4 && !seen[$1]++' > "$tmp"

    mv "$tmp" "$MOUNT_DB"
}

effective_mounts() {
    refresh_mount_db
    cat "$MOUNT_DB"
}

local_ct_ids() {
    pct list 2>/dev/null | awk 'NR > 1 {print $1}'
}

ct_config() {
    pct config "$1" 2>/dev/null
}

cfg_value() {
    local key="$1"
    awk -F': ' -v k="$key" '$1 == k {print $2; exit}'
}

has_tag_string() {
    local tags="$1"
    local wanted="$2"
    local t
    IFS=';' read -r -a _tags <<<"$tags"
    for t in "${_tags[@]:-}"; do
        [[ "$t" == "$wanted" ]] && return 0
    done
    return 1
}

ct_has_gate_tag() {
    local cfg="$1"
    local tags
    tags="$(printf '%s\n' "$cfg" | cfg_value tags)"
    has_tag_string "$tags" "$GATE_TAG"
}

add_gate_tag() {
    local ctid="$1"
    local cfg="$2"
    local tags new_tags
    tags="$(printf '%s\n' "$cfg" | cfg_value tags)"

    has_tag_string "$tags" "$GATE_TAG" && return 0

    if [[ -n "$tags" ]]; then
        new_tags="${tags};${GATE_TAG}"
    else
        new_tags="$GATE_TAG"
    fi

    pct set "$ctid" --tags "$new_tags" >/dev/null
}

remove_gate_tag() {
    local ctid="$1"
    local cfg tags t
    local -a kept=()

    cfg="$(ct_config "$ctid" || true)"
    [[ -n "$cfg" ]] || return 0
    tags="$(printf '%s\n' "$cfg" | cfg_value tags)"

    IFS=';' read -r -a _tags <<<"$tags"
    for t in "${_tags[@]:-}"; do
        [[ -n "$t" && "$t" != "$GATE_TAG" ]] && kept+=("$t")
    done

    if ((${#kept[@]} == 0)); then
        pct set "$ctid" --delete tags >/dev/null 2>&1 || true
    else
        local joined
        joined="$(IFS=';'; echo "${kept[*]}")"
        pct set "$ctid" --tags "$joined" >/dev/null
    fi
}

path_matches_target() {
    local path="$1"
    local target="$2"
    [[ "$path" == "$target" || ( "$target" != "/" && "$path" == "$target/"* ) ]]
}

ct_external_deps() {
    local ctid="$1"
    local src rec target source kind origin best best_len
    local -a mounts=()

    mapfile -t mounts < <(cat "$MOUNT_DB" 2>/dev/null || true)

    while IFS= read -r src; do
        [[ "$src" == /* ]] || continue

        best=""
        best_len=0

        for rec in "${mounts[@]}"; do
            IFS='|' read -r target source kind origin <<<"$rec"
            [[ -n "$target" ]] || continue

            if path_matches_target "$src" "$target" && (( ${#target} > best_len )); then
                best="$target"
                best_len=${#target}
            fi
        done

        [[ -n "$best" ]] && printf '%s\n' "$best"
    done < <(
        ct_config "$ctid" |
        sed -n 's/^mp[0-9][0-9]*:[[:space:]]*\([^,]*\).*/\1/p'
    ) | sort -u
}

enroll_new_cts() {
    local ctid cfg onboot hostname deps

    refresh_mount_db

    while read -r ctid; do
        [[ -n "$ctid" ]] || continue

        cfg="$(ct_config "$ctid" || true)"
        [[ -n "$cfg" ]] || continue

        deps="$(ct_external_deps "$ctid" || true)"
        [[ -n "$deps" ]] || continue

        # Tagged CTs stay managed across migrations/clones.
        if ct_has_gate_tag "$cfg"; then
            continue
        fi

        onboot="$(printf '%s\n' "$cfg" | cfg_value onboot)"
        [[ "$onboot" == "1" ]] || continue

        hostname="$(printf '%s\n' "$cfg" | cfg_value hostname)"
        add_gate_tag "$ctid" "$cfg"
        pct set "$ctid" --onboot 0 >/dev/null
        log "enrolled CT $ctid (${hostname:-unknown}); onboot 1 -> 0; tag=$GATE_TAG"
    done < <(local_ct_ids)
}

managed_local_cts() {
    local ctid cfg
    while read -r ctid; do
        [[ -n "$ctid" ]] || continue
        cfg="$(ct_config "$ctid" || true)"
        [[ -n "$cfg" ]] || continue
        ct_has_gate_tag "$cfg" && printf '%s\n' "$ctid"
    done < <(local_ct_ids)
}

boot_init() {
    require_root
    acquire_lock

    refresh_mount_db
    enroll_new_cts

    : > "$PENDING_FILE"
    while read -r ctid; do
        [[ -n "$ctid" ]] || continue
        # Only gate tagged CTs that still depend on an IP-backed bind mount.
        [[ -n "$(ct_external_deps "$ctid" || true)" ]] || continue
        printf '%s\n' "$ctid" >> "$PENDING_FILE"
    done < <(managed_local_cts)

    sort -nu -o "$PENDING_FILE" "$PENDING_FILE"
    log "boot pending set initialized: $(wc -l < "$PENDING_FILE") CT(s)"
}

# Full-source comparison for kind=full, mirroring Proxmox's own NFS/CIFS
# source validation (effectively `^expected/?$`): the live source matches
# if it equals the expected source, or equals the expected source with
# exactly one additional trailing slash appended - regardless of whether
# expected itself already ends in a slash. Nothing broader is normalized
# (case, extra slashes, subpaths, etc.).
full_source_matches() {
    local expected="$1"
    local actual="$2"

    [[ "$actual" == "$expected" || "$actual" == "$expected/" ]]
}

# Readiness verification for one remembered dependency:
#
#   exact target mounted?
#         | no  -> not-mounted
#         | yes
#   expected remote source? (full: exact match, optional trailing slash;
#                             endpoint: same server only)
#         | no  -> unexpected-source
#         | yes
#   bounded stat() succeeds?
#         | no  -> not-responding
#         | yes
#   READY
#
# A source mismatch never falls through to the responsiveness check: an
# unexpected filesystem occupying the target must never be treated as
# ready just because it happens to answer stat() quickly.
mount_ready_map() {
    local rec target source kind origin actual actual_ip

    while IFS='|' read -r target source kind origin; do
        [[ -n "$target" ]] || continue
        actual="$(findmnt -rn -M "$target" -o SOURCE --raw 2>/dev/null || true)"
        actual="$(decode_findmnt_field "$actual")"

        if [[ -z "$actual" ]]; then
            printf '%s|0|not-mounted\n' "$target"
            continue
        fi

        if [[ "$kind" == "full" ]]; then
            # Exact match (or the narrow trailing-slash exception above)
            # on the complete remote resource: a different share/export on
            # the same server, a different server, or an unrelated local
            # filesystem are all rejected here.
            if ! full_source_matches "$source" "$actual"; then
                printf '%s|0|unexpected-source:%s\n' "$target" "$actual"
                continue
            fi
        else
            # endpoint-only identity: the strongest check available is
            # "same server address", done as an exact match on the
            # extracted address - never a substring check, which could
            # otherwise mistake e.g. 203.0.113.24 for 203.0.113.241.
            actual_ip="$(extract_ip "$actual" || true)"
            if [[ -z "$actual_ip" || "$actual_ip" != "$source" ]]; then
                printf '%s|0|unexpected-source:%s\n' "$target" "$actual"
                continue
            fi
        fi

        if ! timeout -k 2s "${IO_TIMEOUT}s" stat -- "$target" >/dev/null 2>&1; then
            printf '%s|0|not-responding\n' "$target"
            continue
        fi

        printf '%s|1|%s\n' "$target" "$actual"
    done < "$MOUNT_DB"
}

remove_pending_ct() {
    local ctid="$1"
    local tmp
    tmp="$(mktemp)"
    grep -vxF "$ctid" "$PENDING_FILE" 2>/dev/null > "$tmp" || true
    mv "$tmp" "$PENDING_FILE"
}

cycle() {
    require_root
    acquire_lock

    refresh_mount_db
    # New CTs/shares are discovered continuously. Newly enrolled CTs are
    # intentionally NOT added to this boot's pending list; they start next boot.
    enroll_new_cts

    [[ -e "$PENDING_FILE" ]] || {
        log "no boot pending state yet; initializing now"
        : > "$PENDING_FILE"
        while read -r ctid; do
            [[ -n "$(ct_external_deps "$ctid" || true)" ]] && echo "$ctid" >> "$PENDING_FILE"
        done < <(managed_local_cts)
        sort -nu -o "$PENDING_FILE" "$PENDING_FILE"
    }

    declare -A READY REASON
    local target ready reason ctid status dep all_ready
    local -a deps=()

    while IFS='|' read -r target ready reason; do
        READY["$target"]="$ready"
        REASON["$target"]="$reason"
        if [[ "$ready" == "1" ]]; then
            log "mount OK: $target -> $reason"
        else
            log "mount WAIT: $target ($reason)"
        fi
    done < <(mount_ready_map)

    # Work from a snapshot because successful starts mutate PENDING_FILE.
    mapfile -t _pending < "$PENDING_FILE"

    for ctid in "${_pending[@]:-}"; do
        [[ -n "$ctid" ]] || continue

        if ! ct_config "$ctid" >/dev/null 2>&1; then
            log "CT $ctid no longer local/existing; removing from this boot pending set"
            remove_pending_ct "$ctid"
            continue
        fi

        status="$(pct status "$ctid" 2>/dev/null | awk '{print $2}')"
        if [[ "$status" == "running" ]]; then
            log "CT $ctid already running; marking boot startup complete"
            remove_pending_ct "$ctid"
            continue
        fi

        mapfile -t deps < <(ct_external_deps "$ctid")
        if ((${#deps[@]} == 0)); then
            log "CT $ctid no longer has IP-backed bind dependencies; leaving stopped and removing from pending"
            remove_pending_ct "$ctid"
            continue
        fi

        all_ready=1
        for dep in "${deps[@]}"; do
            if [[ "${READY[$dep]:-0}" != "1" ]]; then
                log "CT $ctid waiting for $dep (${REASON[$dep]:-unknown})"
                all_ready=0
            fi
        done

        (( all_ready == 1 )) || continue

        log "starting CT $ctid"
        if pct start "$ctid"; then
            log "CT $ctid started"
            remove_pending_ct "$ctid"
        else
            log "CT $ctid start failed; keeping it pending"
        fi
    done
}

start_now() {
    require_root
    local ctid="$1"
    [[ "$ctid" =~ ^[0-9]+$ ]] || die "invalid CTID: $ctid"

    acquire_lock
    refresh_mount_db

    local cfg deps onboot
    cfg="$(ct_config "$ctid" || true)"
    [[ -n "$cfg" ]] || die "CT $ctid not found on this node"
    deps="$(ct_external_deps "$ctid" || true)"
    [[ -n "$deps" ]] || die "CT $ctid has no IP-backed bind mount dependency"

    if ! ct_has_gate_tag "$cfg"; then
        onboot="$(printf '%s\n' "$cfg" | cfg_value onboot)"
        add_gate_tag "$ctid" "$cfg"
        [[ "$onboot" == "1" ]] && pct set "$ctid" --onboot 0 >/dev/null
        log "enrolled CT $ctid"
    fi

    touch "$PENDING_FILE"
    grep -qxF "$ctid" "$PENDING_FILE" || echo "$ctid" >> "$PENDING_FILE"
    sort -nu -o "$PENDING_FILE" "$PENDING_FILE"

    # Release shell lock fd before invoking a fresh cycle which reacquires it.
    exec 9>&-
    cycle
}

unenroll_ct() {
    require_root
    local ctid="$1"
    local restore_onboot="${2:-0}"
    acquire_lock

    local cfg
    cfg="$(ct_config "$ctid" || true)"
    [[ -n "$cfg" ]] || die "CT $ctid not found on this node"

    remove_gate_tag "$ctid"
    if [[ "$restore_onboot" == "1" ]]; then
        pct set "$ctid" --onboot 1 >/dev/null
    fi
    [[ -e "$PENDING_FILE" ]] && remove_pending_ct "$ctid"
    log "unenrolled CT $ctid; restore_onboot=$restore_onboot"
}

forget_mount() {
    require_root
    local target="${1%/}"
    local tmp
    acquire_lock
    tmp="$(mktemp)"
    awk -F'|' -v t="$target" '$1 != t {print}' "$MOUNT_DB" > "$tmp"
    mv "$tmp" "$MOUNT_DB"
    log "forgot remembered mount: $target"
}

status_cmd() {
    ensure_runtime
    refresh_mount_db

    echo "Configured tag: $GATE_TAG"
    echo
    echo "Known IP-backed mounts (TARGET / SOURCE / KIND / ORIGIN):"
    if [[ -s "$MOUNT_DB" ]]; then
        { printf 'TARGET|SOURCE|KIND|ORIGIN\n'; cat "$MOUNT_DB"; } |
            column -t -s'|' 2>/dev/null || cat "$MOUNT_DB"
    else
        echo "  (none)"
    fi

    echo
    echo "Managed local LXCs:"
    local any=0 ctid cfg host
    while read -r ctid; do
        any=1
        cfg="$(ct_config "$ctid" || true)"
        host="$(printf '%s\n' "$cfg" | cfg_value hostname)"
        printf '  CT %-6s %s\n' "$ctid" "${host:-unknown}"
    done < <(managed_local_cts)
    (( any == 1 )) || echo "  (none)"

    echo
    echo "Pending this boot:"
    if [[ -s "$PENDING_FILE" ]]; then
        sed 's/^/  CT /' "$PENDING_FILE"
    else
        echo "  (none)"
    fi
}

usage() {
    cat <<EOF_USAGE
Usage: $0 COMMAND

Commands:
  --discover                 Refresh and print known IP-backed mounts
  --enroll                   Auto-enroll new onboot=1 dependent LXCs
  --boot-init                Build this boot's pending startup set
  --cycle                    Discover/enroll and start ready pending LXCs
  --start-now CTID           Add one managed CT to this boot's pending set
  --unenroll CTID            Remove gate tag; keep onboot=0
  --unenroll-onboot CTID     Remove gate tag and restore onboot=1
  --forget-mount PATH        Remove a remembered custom mount from the DB
  --status                   Show mounts, managed CTs and boot pending CTs
EOF_USAGE
}

main() {
    case "${1:-}" in
        --discover)
            require_root
            acquire_lock
            effective_mounts
            ;;
        --enroll)
            require_root
            acquire_lock
            enroll_new_cts
            ;;
        --boot-init)
            boot_init
            ;;
        --cycle)
            cycle
            ;;
        --start-now)
            [[ $# -eq 2 ]] || { usage; exit 2; }
            start_now "$2"
            ;;
        --unenroll)
            [[ $# -eq 2 ]] || { usage; exit 2; }
            unenroll_ct "$2" 0
            ;;
        --unenroll-onboot)
            [[ $# -eq 2 ]] || { usage; exit 2; }
            unenroll_ct "$2" 1
            ;;
        --forget-mount)
            [[ $# -eq 2 ]] || { usage; exit 2; }
            forget_mount "$2"
            ;;
        --status)
            status_cmd
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

